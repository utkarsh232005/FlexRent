<% layout("/layouts/boilerplate") %>

    <div class="main mt-5">
        <!-- <h3 class="heading">All Listings</h3> -->
        <!-- <form method="GET" action="/listings/new">
            <button>Create New Listing</button>
        </form> -->
        <div class="filter-bar-wrap">
            <div id="filters">
                <div class="filter active" data-filter="trending">
                    <i class="fa-solid fa-fire"></i>
                    <p>Trending</p>
                </div>
                <div class="filter" data-filter="rooms">
                    <i class="fa-solid fa-bed"></i>
                    <p>Rooms</p>
                </div>
                <div class="filter" data-filter="views">
                    <i class="fa-solid fa-mountain-sun"></i>
                    <p>Amazing views</p>
                </div>
                <div class="filter" data-filter="cities">
                    <i class="fa-solid fa-city"></i>
                    <p>Iconic cities</p>
                </div>
                <div class="filter" data-filter="surfing">
                    <i class="fa-solid fa-person-surfing"></i>
                    <p>Surfing</p>
                </div>
                <div class="filter" data-filter="pools">
                    <i class="fa-solid fa-water-ladder"></i>
                    <p>Amazing pools</p>
                </div>
                <div class="filter" data-filter="beach">
                    <i class="fa-solid fa-umbrella-beach"></i>
                    <p>Beach</p>
                </div>
                <div class="filter" data-filter="cabins">
                    <i class="fa-solid fa-house-chimney"></i>
                    <p>Cabins</p>
                </div>
                <div class="filter" data-filter="farms">
                    <i class="fa-solid fa-tractor"></i>
                    <p>Farms</p>
                </div>
                <div class="filter" data-filter="omg">
                    <i class="fa-solid fa-face-surprise"></i>
                    <p>OMG!</p>
                </div>
                <div class="filter" data-filter="lakefront">
                    <i class="fa-solid fa-water"></i>
                    <p>Lakefront</p>
                </div>
                <div class="filter" data-filter="camping">
                    <i class="fa-solid fa-campground"></i>
                    <p>Camping</p>
                </div>
            </div>
            <div class="filter-actions">
                <button class="filter-btn">
                    <i class="fa-solid fa-sliders me-1"></i> Filters
                </button>
            </div>
        </div>

        <% if (searchQuery) { %>
        <div class="search-result-header">
            <p>
                <% if (allListings.length > 0) { %>
                    <span class="search-result-count"><%= allListings.length %></span> result<%= allListings.length !== 1 ? 's' : '' %> for
                <% } else { %>
                    No results for
                <% } %>
                "<strong><%= searchQuery %></strong>"
                &nbsp;·&nbsp; <a href="/listings" class="search-clear">Clear</a>
            </p>
        </div>
        <% } %>

        <% if (allListings.length === 0) { %>
        <div class="search-empty">
            <i class="fa-regular fa-face-sad-tear fa-3x mb-3" style="color:#dddddd;"></i>
            <h5>No listings found</h5>
            <p>Try a different location or keyword.</p>
            <a href="/listings" class="sp-btn sp-btn--primary px-4">Browse all listings</a>
        </div>
        <% } else { %>
        <div class="row row-cols-lg-4 row-cols-md-3 row-cols-sm-2 row-cols-1 g-4 mt-2">
            <% for(let listing of allListings) { %>
                <a href="/listings/<%= listing._id %>" class="listing-link">
                    <div class="card listing-card col" style="width: 20rem">
                        <img src="<%= listing.image.url %>" class="card-img-top" alt="listing-image"
                            style="height: 20rem;">
                        <div class="card-img-overlay"></div>
                        <div class="card-body">
                            <p class="card-text">
                                <b>
                                    <%= listing.title %>
                                </b> <br>
                                ₹<%= listing.price.toLocaleString("en-IN") %>/ night
                            </p>
                        </div>
                    </div>
                </a>
                <% } %>
        </div>
        <% } %>
    </div>